# Copy to .env and edit:  cp -n .env.example .env   (-n never overwrites an existing .env)
# All settings are optional; defaults are shown.
#
# The home city is NOT set here. On first launch AURA detects it approximately
# from the internet connection, and you can correct it from the dashboard
# ("Location" button under the clock). It is saved in data/location.json.

# --- Display ---
# 12h or 24h
AURA_CLOCK_FORMAT=12h
# Fallback timezone used only until a home location is set.
# Empty = the Pi's own system timezone.
AURA_TIMEZONE=

# --- Location ---
# ip  : on first launch, detect the approximate city from the home IP address
# off : never contact IP geolocation services; set the city manually instead
AURA_LOCATION_DETECTION=ip
# Optional free ipinfo.io token for more reliable detection. Server-side only.
# AURA_IPINFO_TOKEN=

# --- Weather ---
# open_meteo : live weather from Open-Meteo (free for non-commercial use, no key)
# mock       : DEVELOPMENT PREVIEW with sample data, clearly labelled on screen
# none       : weather turned off
AURA_WEATHER_PROVIDER=open_meteo
# How often to fetch new data from the provider (seconds).
AURA_WEATHER_REFRESH_SECONDS=900
# After a failed fetch, wait this long before trying again (seconds).
AURA_WEATHER_RETRY_SECONDS=120
# Keep showing the last good data (marked as outdated) for up to this many hours.
AURA_WEATHER_MAX_STALE_HOURS=6
AURA_HTTP_TIMEOUT_SECONDS=8
# "Before you go" advice looks this many hours ahead.
AURA_TRAVEL_WINDOW_HOURS=6

# --- Household access (phones) ---
# Who may change the grocery list and location settings:
#   lan : any phone or computer on the home Wi-Fi, no PIN (default)
#   pin : only the Pi itself, plus phones that entered AURA_HOUSEHOLD_PIN once
# Either way, nothing outside the home network can connect.
AURA_EDIT_ACCESS=lan
# Only used when AURA_EDIT_ACCESS=pin. At least 6 characters.
AURA_HOUSEHOLD_PIN=
AURA_SESSION_DAYS=365
AURA_TRUST_LOCALHOST=true
# Address encoded in the dashboard's QR code. Empty = the Pi's current LAN IP
# (looked up live, so it follows DHCP changes). Example: http://192.168.1.11:8080
AURA_PUBLIC_URL=

# --- Weekday commute (home -> office) ---
# Monitors Mon-Fri 07:00-11:00 (Asia/Kolkata) and recommends when to leave.
# Live traffic needs a FREE TomTom API key: https://developer.tomtom.com
# (free plan: 20,000 routing requests/month, no credit card). AURA uses about
# 100 requests per weekday and never more than AURA_COMMUTE_MAX_REQUESTS_PER_DAY.
# Coordinates and the key stay on the Pi; the dashboard only shows the labels.
AURA_COMMUTE_ENABLED=true
AURA_COMMUTE_PROVIDER=tomtom
AURA_TOMTOM_API_KEY=
AURA_COMMUTE_HOME=
AURA_COMMUTE_OFFICE=
AURA_COMMUTE_HOME_LABEL=Home
AURA_COMMUTE_OFFICE_LABEL=Office
AURA_COMMUTE_TIMEZONE=Asia/Kolkata
AURA_COMMUTE_WINDOW_START=07:00
AURA_COMMUTE_WINDOW_END=11:00
AURA_COMMUTE_SLOT_MINUTES=15
AURA_COMMUTE_DAYS=mon,tue,wed,thu,fri
# Days with no monitoring, comma-separated YYYY-MM-DD (e.g. 2026-10-20,2026-11-01)
AURA_COMMUTE_HOLIDAYS=
# Forecast for all slots this many minutes before the window opens
AURA_COMMUTE_PREFETCH_MINUTES=15
# During the window: live "leave now" check / refresh of the remaining slots
AURA_COMMUTE_LIVE_REFRESH_MINUTES=15
AURA_COMMUTE_FORECAST_REFRESH_MINUTES=30
AURA_COMMUTE_MAX_REQUESTS_PER_DAY=200
# Keep stored observations (for weekday traffic patterns) this long
AURA_COMMUTE_HISTORY_DAYS=180

# --- Calendars (events, birthdays, holidays) ---
# Comma-separated "Label|https://...ics" entries. In Google Calendar:
# Settings -> your calendar -> "Secret address in iCal format". Treat private
# addresses like passwords (anyone with the link can read the calendar).
# Example: Personal|https://calendar.google.com/calendar/ical/.../basic.ics
AURA_CALENDAR_FEEDS=
AURA_CALENDAR_REFRESH_MINUTES=30
AURA_CALENDAR_DAYS_AHEAD=30

# --- Network (home network only) ---
# 0.0.0.0 = all IPv4 interfaces (LAN + localhost). No IPv6, so the Pi's global
# IPv6 address is not used. For localhost only, use 127.0.0.1.
AURA_HOST=0.0.0.0
AURA_PORT=8080
# Hostnames accepted in the browser's address bar, comma-separated.
# Private IP addresses (e.g. 192.168.1.11) are always accepted.
AURA_ALLOWED_HOSTS=localhost,aura-pi,aura-pi.local
# Reject any client that is not on loopback / private / link-local addresses.
AURA_LAN_ONLY=true

# --- Voice assistant (local; see README -> Voice assistant) ---
# Microphone (ALSA name from `arecord -L`). Audio is never saved.
AURA_VOICE_ENABLED=true
AURA_VOICE_MIC_DEVICE=plughw:CARD=Device,DEV=0
AURA_VOICE_PORT=8091
AURA_VOICE_STT_MODEL=small.en
AURA_VOICE_WAKE_CHECK_MODEL=base.en
AURA_VOICE_TTS_VOICE=en_US-lessac-medium

# --- Network protection (Pi-hole status in Settings; see README -> Network protection) ---
# App password from Pi-hole admin -> Settings -> Web interface / API -> Configure app password.
# Optional: without it Settings still shows service and DNS health, just no statistics.
AURA_PIHOLE_APP_PASSWORD=

# --- Smart home (Home Assistant on this Pi; see README -> Smart home) ---
# Set by deploy/homeassistant/connect.sh (a long-lived access token from your Home Assistant profile).
AURA_HOMEASSISTANT_URL=http://127.0.0.1:8123
AURA_HOMEASSISTANT_TOKEN=

# --- Price Tracker (gold and silver in India; see README -> Price Tracker) ---
# Free key from https://metals.dev (100 requests a month; AURA uses about 30).
AURA_METALS_DEV_API_KEY=
