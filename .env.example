# Copy to .env and edit:  cp -n .env.example .env   (-n never overwrites an existing .env)
# All settings are optional; defaults are shown.
#
# The home city is NOT set here. On first launch AURA detects it approximately
# from the internet connection, and you can correct it from the dashboard
# ("Location" button under the clock). It is saved in data/location.json.

# --- Display ---
# 12h or 24h
AURA_CLOCK_FORMAT=12h
# Fallback timezone used only until a home location is set.
# Empty = the Pi's own system timezone.
AURA_TIMEZONE=

# --- Location ---
# ip  : on first launch, detect the approximate city from the home IP address
# off : never contact IP geolocation services; set the city manually instead
AURA_LOCATION_DETECTION=ip
# Optional free ipinfo.io token for more reliable detection. Server-side only.
# AURA_IPINFO_TOKEN=

# --- Weather ---
# open_meteo : live weather from Open-Meteo (free for non-commercial use, no key)
# mock       : DEVELOPMENT PREVIEW with sample data, clearly labelled on screen
# none       : weather turned off
AURA_WEATHER_PROVIDER=open_meteo
# How often to fetch new data from the provider (seconds).
AURA_WEATHER_REFRESH_SECONDS=900
# After a failed fetch, wait this long before trying again (seconds).
AURA_WEATHER_RETRY_SECONDS=120
# Keep showing the last good data (marked as outdated) for up to this many hours.
AURA_WEATHER_MAX_STALE_HOURS=6
AURA_HTTP_TIMEOUT_SECONDS=8
# "Before you go" advice looks this many hours ahead.
AURA_TRAVEL_WINDOW_HOURS=6

# --- Household access (phones) ---
# Who may change the grocery list and location settings:
#   lan : any phone or computer on the home Wi-Fi, no PIN (default)
#   pin : only the Pi itself, plus phones that entered AURA_HOUSEHOLD_PIN once
# Either way, nothing outside the home network can connect.
AURA_EDIT_ACCESS=lan
# Only used when AURA_EDIT_ACCESS=pin. At least 6 characters.
AURA_HOUSEHOLD_PIN=
AURA_SESSION_DAYS=365
AURA_TRUST_LOCALHOST=true
# Address encoded in the dashboard's QR code. Empty = the Pi's current LAN IP
# (looked up live, so it follows DHCP changes). Example: http://192.168.1.11:8080
AURA_PUBLIC_URL=

# --- Network (home network only) ---
# 0.0.0.0 = all IPv4 interfaces (LAN + localhost). No IPv6, so the Pi's global
# IPv6 address is not used. For localhost only, use 127.0.0.1.
AURA_HOST=0.0.0.0
AURA_PORT=8080
# Hostnames accepted in the browser's address bar, comma-separated.
# Private IP addresses (e.g. 192.168.1.11) are always accepted.
AURA_ALLOWED_HOSTS=localhost,aura-pi,aura-pi.local
# Reject any client that is not on loopback / private / link-local addresses.
AURA_LAN_ONLY=true
